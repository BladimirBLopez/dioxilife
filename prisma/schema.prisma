generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Departamento {
  LA_PAZ
  SANTA_CRUZ
  COCHABAMBA
  ORURO
  POTOSI
  CHUQUISACA
  TARIJA
  BENI
  PANDO
}

model Categoria {
  id        String     @id @default(cuid())
  nombre    String
  slug      String     @unique
  productos Producto[]
  createdAt DateTime   @default(now())
}

model Producto {
  id                    String                 @id @default(cuid())
  nombre                String
  slug                  String                 @unique
  descripcion           String?
  precio                Decimal
  mostrarPrecio         Boolean                @default(false)
  enPromocion           Boolean                @default(false)
  precioPromocion       Decimal?
  valorComisionable     Decimal                @default(0)
  puntosVolumen         Decimal                @default(0)
  generaComision        Boolean                @default(false)
  imagenUrl             String?
  categoriaId           String
  categoria             Categoria              @relation(fields: [categoriaId], references: [id])
  protocolos            Protocolo[]
  informacionProducto   InformacionProducto[]
  resenas               Resena[]
  movimientosInventario MovimientoInventario[]
  stockActual           Int                    @default(0)
  stockMinimo           Int                    @default(5)
  orden                 Int                    @default(0)
  activo                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  detallePedidos        DetallePedido[]
}

model Protocolo {
  id         String   @id @default(cuid())
  titulo     String
  contenido  String
  imagenUrl  String?
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum TipoInformacion {
  BENEFICIO
  VIDEO
  INGREDIENTE
  FAQ
  DOCUMENTO
}

model InformacionProducto {
  id        String          @id @default(cuid())
  tipo      TipoInformacion
  titulo    String
  contenido String?
  imagenUrl String?
  videoUrl  String?
  orden     Int             @default(0)
  activo    Boolean         @default(true)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productoId])
}

model AplicacionCds {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  imagenUrl   String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Resena {
  id            String    @id @default(cuid())
  nombreCliente String
  calificacion  Int
  comentario    String
  imagenUrl     String?
  ipHash        String?
  productoId    String?
  producto      Producto? @relation(fields: [productoId], references: [id], onDelete: Cascade)
  aprobado      Boolean   @default(false)
  tiempoUso     String?
  destacado     Boolean   @default(false)
  createdAt     DateTime  @default(now())
}

model Sucursal {
  id            String       @id @default(cuid())
  departamento  Departamento
  nombre        String?
  direccion     String?
  telefono      String?
  googleMapsUrl String?
  facebookUrl   String?
  tiktokUrl     String?
  instagramUrl  String?
  activo        Boolean      @default(true)
  createdAt     DateTime     @default(now())
}

enum RolAdmin {
  SUPER_ADMIN
  ADMIN
}

model Admin {
  id                    String                 @id @default(cuid())
  usuario               String                 @unique
  passwordHash          String
  rol                   RolAdmin               @default(ADMIN)
  movimientosInventario MovimientoInventario[]
  createdAt             DateTime               @default(now())
}

model Banner {
  id              String   @id @default(cuid())
  titulo          String?
  subtitulo       String?
  textoBoton      String?
  tipoBoton       String   @default("LINK")
  linkBoton       String?
  mensajeWhatsapp String?
  imagenUrl       String?
  mostrarTexto    Boolean  @default(true)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum EstadoMiembro {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

enum EstadoComision {
  PENDIENTE
  APROBADA
  PAGADA
  ANULADA
}

model Miembro {
  id                    String  @id @default(cuid())
  nombres               String
  apellidos             String?
  email                 String  @unique
  telefono              String?
  direccion             String?
  googleMapsUrl         String?
  esDistribuidorPublico Boolean @default(false)
  passwordHash          String
  codigoReferido        String  @unique

  patrocinadorId String?
  patrocinador   Miembro?  @relation("RedMultinivel", fields: [patrocinadorId], references: [id], onDelete: SetNull)
  referidos      Miembro[] @relation("RedMultinivel")

  estado EstadoMiembro @default(ACTIVO)

  activado              Boolean   @default(true)
  tokenActivacionHash   String?   @unique
  tokenActivacionExpira DateTime?
  fechaActivacion       DateTime?

  comisionesRecibidas ComisionMultinivel[] @relation("ComisionesBeneficiario")
  comisionesGeneradas ComisionMultinivel[] @relation("ComisionesOrigen")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  pedidos          Pedido[] @relation("PedidosComprador")
  pedidosReferidos Pedido[] @relation("PedidosReferidos")

  @@index([patrocinadorId])
  @@index([estado])
}

model ComisionMultinivel {
  id String @id @default(cuid())

  beneficiarioId String
  beneficiario   Miembro @relation("ComisionesBeneficiario", fields: [beneficiarioId], references: [id], onDelete: Cascade)

  origenMiembroId String
  origenMiembro   Miembro @relation("ComisionesOrigen", fields: [origenMiembroId], references: [id], onDelete: Cascade)

  pedidoId String?
  pedido   Pedido? @relation("ComisionesPedido", fields: [pedidoId], references: [id], onDelete: SetNull)

  nivel      Int
  montoBase  Decimal?
  porcentaje Decimal?
  monto      Decimal
  concepto   String?
  estado     EstadoComision @default(PENDIENTE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pedidoId, beneficiarioId, nivel])
  @@index([beneficiarioId])
  @@index([origenMiembroId])
  @@index([estado])
  @@index([createdAt])
}

model ConfiguracionComisiones {
  id String @id @default("GLOBAL")

  comisionDirecta Decimal @default(10)
  nivel1          Decimal @default(5)
  nivel2          Decimal @default(3)
  nivel3          Decimal @default(2)

  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EstadoPedido {
  NUEVO
  CONFIRMADO
  PAGO_REPORTADO
  PAGADO
  COMPLETADO
  CANCELADO
}

model Pedido {
  id         String       @id @default(cuid())
  codigo     String       @unique
  claveUnica String?      @unique
  estado     EstadoPedido @default(NUEVO)

  nombreCliente    String?
  telefonoCliente  String?
  ciudadCliente    String?
  direccionCliente String?
  observaciones    String?

  miembroId     String?
  miembro       Miembro? @relation("PedidosComprador", fields: [miembroId], references: [id], onDelete: SetNull)
  referidoPorId String?
  referidoPor   Miembro? @relation("PedidosReferidos", fields: [referidoPorId], references: [id], onDelete: SetNull)

  total   Decimal @default(0)
  totalCV Decimal @default(0)
  totalPV Decimal @default(0)

  requiereCotizacion Boolean @default(false)

  detalles              DetallePedido[]
  comisiones            ComisionMultinivel[]   @relation("ComisionesPedido")
  movimientosInventario MovimientoInventario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([codigo])
  @@index([estado])
  @@index([miembroId])
  @@index([referidoPorId])
  @@index([createdAt])
}

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
  VENTA
  DEVOLUCION
  AJUSTE
}

model MovimientoInventario {
  id String @id @default(cuid())

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  tipo     TipoMovimientoInventario
  cantidad Int

  stockAnterior Int
  stockNuevo    Int

  motivo String?

  pedidoId String?
  pedido   Pedido? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)

  adminId String?
  admin   Admin?  @relation(fields: [adminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productoId])
  @@index([pedidoId])
  @@index([adminId])
  @@index([tipo])
  @@index([createdAt])
}

model DetallePedido {
  id String @id @default(cuid())

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad Int

  nombreProducto String
  precioUnitario Decimal
  mostrarPrecio  Boolean

  generaComision    Boolean @default(false)
  valorComisionable Decimal @default(0)
  puntosVolumen     Decimal @default(0)

  subtotal   Decimal @default(0)
  subtotalCV Decimal @default(0)
  subtotalPV Decimal @default(0)

  createdAt DateTime @default(now())

  @@index([pedidoId])
  @@index([productoId])
}
