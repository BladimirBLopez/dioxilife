generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Departamento {
  LA_PAZ
  SANTA_CRUZ
  COCHABAMBA
  ORURO
  POTOSI
  CHUQUISACA
  TARIJA
  BENI
  PANDO
}

model Categoria {
  id        String     @id @default(cuid())
  nombre    String
  slug      String     @unique
  productos Producto[]
  createdAt DateTime   @default(now())
}

model Producto {
  id              String      @id @default(cuid())
  nombre          String
  slug            String      @unique
  descripcion     String?
  precio          Decimal
  mostrarPrecio   Boolean     @default(false)
  enPromocion     Boolean     @default(false)
  precioPromocion Decimal?
  imagenUrl       String?
  categoriaId     String
  categoria       Categoria   @relation(fields: [categoriaId], references: [id])
  protocolos      Protocolo[]
  resenas         Resena[]
  orden           Int         @default(0)
  activo          Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Protocolo {
  id         String   @id @default(cuid())
  titulo     String
  contenido  String
  imagenUrl  String?
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AplicacionCds {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  imagenUrl   String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Resena {
  id            String    @id @default(cuid())
  nombreCliente String
  calificacion  Int
  comentario    String
  imagenUrl     String?
  ipHash        String?
  productoId    String?
  producto      Producto? @relation(fields: [productoId], references: [id], onDelete: Cascade)
  aprobado      Boolean   @default(false)
  createdAt     DateTime  @default(now())
}

model Sucursal {
  id           String       @id @default(cuid())
  departamento Departamento
  nombre       String?
  direccion    String?
  telefono     String?
  facebookUrl  String?
  tiktokUrl    String?
  instagramUrl String?
  activo       Boolean      @default(true)
  createdAt    DateTime     @default(now())
}

model Admin {
  id           String   @id @default(cuid())
  usuario      String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Banner {
  id              String   @id @default(cuid())
  titulo          String?
  subtitulo       String?
  textoBoton      String?
  tipoBoton       String   @default("LINK")
  linkBoton       String?
  mensajeWhatsapp String?
  imagenUrl       String?
  mostrarTexto    Boolean  @default(true)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
